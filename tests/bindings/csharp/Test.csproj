<Project Sdk="Microsoft.NET.Sdk">

  <!-- The C# binding: every case of vectors.json through its call. It references the wrapper and copies
       the native library beside the exe. RantDir names Rant's checkout, NativeLibrary the built library. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>RantMathTest</RootNamespace>
    <RollForward>Major</RollForward>
    <RantDir Condition="'$(RantDir)' == ''">$(MSBuildThisFileDirectory)../../../../rant</RantDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../generated/CSharpThunks.g.cs" />
    <ProjectReference Include="../../../bindings/csharp/Rant.Math.csproj" />
    <ProjectReference Include="$(RantDir)/bindings/csharp/types/Rant.Types.csproj" />
    <None Include="$(NativeLibrary)" Condition="'$(NativeLibrary)' != ''" CopyToOutputDirectory="Always" Link="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
