    Matrix o2 = impl::matrix_out(a.cols, (a.rows < a.cols ? a.rows : a.cols));
    impl::check(detail::rant_matrix_svd(impl::matrix(a), impl::matrix(o0), o1.data(), impl::matrix(o2)));
    return std::tuple<Matrix, std::vector<double>, Matrix>{ std::move(o0), std::move(o1), std::move(o2) };
}

