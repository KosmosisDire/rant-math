/* The points keep marks with 1, whole and in order, into data at point_step bytes each. */
inline PointCloud point_cloud_select(const PointCloudView &cloud, Span<const uint8_t> keep) {
    const detail::RantPointCloudView &c = *cloud.raw();
    impl::check(detail::rant_point_cloud_check(&c));
    if (keep.size() != c.size / c.point_step) impl::argument();
    uint32_t n = 0;
    impl::room(detail::rant_point_cloud_select(&c, keep.data(), nullptr, &n));
    PointCloud out = impl::cloud_like(c);
    out.data.resize(size_t(n) * c.point_step);
    impl::check(detail::rant_point_cloud_select(&c, keep.data(), out.data.data(), &n));
    return out;
}

