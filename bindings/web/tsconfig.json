{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM", "ESNext.Disposable"],
        "declaration": true,
        "outDir": "dist",
        "rootDir": "src",
        "strict": true,
        "skipLibCheck": true,
        "noEmitOnError": true,
        "allowJs": false
    },
    "include": ["src/**/*.ts"]
}
